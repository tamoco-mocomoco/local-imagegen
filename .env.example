# プリセット名 (sdxl-turbo | sd15 | sdxl | anime | flux-schnell | zimage-turbo)
# ゲームキャラ・アニメ調なら anime、素早い下書きなら sdxl-turbo
PRESET=anime
# 任意の Hugging Face モデル ID で上書きしたい場合
#MODEL_ID=stabilityai/sdxl-turbo
# gated モデル (FLUX.1-dev, SD3.5 など) を使う場合のみ
#HF_TOKEN=hf_xxx
# 公開ポート
PORT=8000
# VRAM が足りない GPU で大きいモデルを動かす場合 (CUDA のみ)
#CPU_OFFLOAD=1
# 起動時にモデルを読み込まず、最初のリクエスト時に読み込む
#PRELOAD=0
